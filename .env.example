# Template de variaveis de ambiente.
# Copie para .env e preencha localmente. Nunca versione valores reais.
# cp .env.example .env && chmod 600 .env

# --------------------------------------------
# Version Control & CI/CD
# --------------------------------------------

# GitHub Token (for GitHub CLI and API access)
# Create at: https://github.com/settings/tokens
# Token para acessar o kanban Projects https://github.com/orgs/bibline/projects/2/views/1
# Token Classic para gerenciar Kanban Bibline Aulas
# User Italo-bibline - bibline-kanban
GITHUB_TOKEN_CLASSIC_KANBAN_BIBLINE_AULAS=
# GitHub Token (for GitHub CLI and API access)
# Create at: https://github.com/settings/tokens
# Token Classic para gerenciar Educare-christianus-kanban-projects
# Token Fine para Sync do Repository: https://github.com/italogabriel-lab/Projeto-Editorial-Education
# User italogabriel-lab
GITHUB_TOKEN_FINE=
GITHUB_TOKEN_CLASSIC=

# --------------------------------------------
# LLM Providers
# --------------------------------------------

# DeepSeek API (for claude-free command)
# Get your key at: https://platform.deepseek.com/api_keys
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=

# GLM - https://z.ai/chat
GLM_API_KEY=

# OpenRouter API (for multi-model routing)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API (direct, if not using Claude Max subscription)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=


## Pollinations.ai - Plataforma recomendada - geracao de imagens
POLLINATIONS_KEY=

# Google AI Studio - Gemini
GEMINI_API_KEY=

# Image Generation Settings
GEMINI_MODEL=gemini-2.5-flash-image
IMAGE_FORMAT=png
IMAGE_RATIO=2:1
