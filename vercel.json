{
  "version": 2,
  "builds": [
    {
      "src": "src/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/src/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/src/index.html"
    },
    {
      "src": "/metas.html",
      "dest": "/src/metas.html"
    },
    {
      "src": "/metas-disciplinas.html",
      "dest": "/src/metas-disciplinas.html"
    },
    {
      "src": "/videos.html",
      "dest": "/src/videos.html"
    },
    {
      "src": "/agent-command-center.html",
      "dest": "/src/agent-command-center.html"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    }
  ]
}
